# ==============================================================================
# JobPilot AI — environment configuration
# Copy to .env and fill in real values. Never commit the real .env file.
# ==============================================================================

# ---- App ----
APP_NAME=JobPilot AI
APP_ENV=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-dev-secret-key
JWT_SECRET=change-me-dev-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (PostgreSQL) ----
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL used by the backend (async driver). Compose overrides POSTGRES_HOST=postgres.
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot
# Sync URL used by Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg2://jobpilot:jobpilot@localhost:5432/jobpilot

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Celery (Rapid Apply worker, Phase 7) ----
# True runs Celery tasks synchronously in-process (handy for a single-
# process dev setup or CI); production with a separate `worker`/`beat`
# process (see docker-compose.yml) should leave this False.
CELERY_TASK_ALWAYS_EAGER=false

# ---- Browser automation (Phase 8) ----
# Base URL automation uses to reach THIS backend's own mock application-form
# server (app/api/mock_forms.py). Automation never targets anything else —
# this build never automates a real job portal.
MOCK_FORM_BASE_URL=http://localhost:8000

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- AI provider (abstraction layer — see app/ai) ----
# Defaults to "mock" so the app runs with zero external dependencies out of
# the box (deterministic explanation text instead of an LLM call). Switch to
# openai/anthropic and set AI_API_KEY once you want real generated text for
# application-question answers and resume tailoring (Phase 9).
AI_PROVIDER=mock                # mock | openai | anthropic
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- Email (notifications, Phase 10+) ----
EMAIL_API_KEY=
EMAIL_FROM=noreply@jobpilot.ai

# ---- Storage (resumes, Phase 3+) ----
STORAGE_URL=./storage
STORAGE_BACKEND=local          # local | s3

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api
